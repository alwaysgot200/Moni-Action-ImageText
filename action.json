      "default": "SourceHanSansSC-Regular",
      "label_key": "options.font",
      "type": "string"
    },
    "group": {
      "default": true,
      "label_key": "options.group",
      "type": "boolean"
    },
    "lang": {
      "default": "ch",
      "label_key": "options.lang",
      "type": "string"
    },
    "launch_app": {
      "default": true,
      "label_key": "options.launch_app",
      "type": "boolean"
    },
    "min_score": {
