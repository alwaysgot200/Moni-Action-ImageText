{
  "schema": "moni-action-v1",
  "id": "ps.image-to-text",
  "version": "1.2.2",
  "display": { "key": "action.name" },
  "type": "script",
  "engine": { "name": "lua", "version": "5.4" },
  "entry": "main.lua",
  "setup": {
    "entry": "setup.lua",
    "label": { "key": "setup.label" }
  },
  "compat": {
    "platforms": ["windows", "macos"],
    "arch": ["any"],
    "host": ">=0.1.0 <2.0.0",
    "features": ["ocr.ppocr>=1", "ps.jsx>=1"],
    "apps": [{ "id": "photoshop", "min": "22.0" }]
  },
  "applies_to": ["photoshop"],
  "permissions": [
    "screen.capture",
    "ocr.run",
    "notify",
    "process.spawn:photoshop",
    "process.spawn:osascript"
  ],
  "programs": [
    {
      "id": "photoshop",
      "candidates": [
        "%ProgramFiles%/Adobe/Adobe Photoshop*/Photoshop.exe",
        "%ProgramFiles%/Adobe Photoshop*/Photoshop.exe",
        "%ProgramFiles(x86)%/Adobe/Adobe Photoshop*/Photoshop.exe",
        "%ProgramFiles(x86)%/Adobe Photoshop*/Photoshop.exe",
        "/Applications/Adobe Photoshop*/Adobe Photoshop*.app/Contents/MacOS/Adobe Photoshop*"
      ]
    },
    {
      "id": "osascript",
      "candidates": ["/usr/bin/osascript"]
    }
  ],
  "options": {
    "launch_app": { "type": "boolean", "default": true, "label_key": "options.launch_app" },
    "lang": {
      "type": "string",
      "default": "ch",
      "label_key": "options.lang"
    },
    "min_score": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "label_key": "options.min_score"
    },
    "font": { "type": "string", "default": "SourceHanSansSC-Regular", "label_key": "options.font" },
    "fit_mode": {
      "type": "enum",
      "values": ["auto", "height", "width"],
      "default": "height",
      "label_key": "options.fit_mode"
    },
    "color_mode": {
      "type": "enum",
      "values": ["sample", "black", "white"],
      "default": "sample",
      "label_key": "options.color_mode"
    },
    "calibration": {
      "type": "enum",
      "values": ["normalized", "selection"],
      "default": "normalized",
      "label_key": "options.calibration"
    },
    "group": { "type": "boolean", "default": true, "label_key": "options.group" }
  },
  "ui": { "icon": "ocr", "group": "photoshop" }
}
